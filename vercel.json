{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/unete", "destination": "/" },
    { "source": "/socios", "destination": "/" },
    {
      "source": "/mi-comercio",
      "destination": "/mi-comercio/index.html"
    },
    {
      "source": "/mi-comercio/",
      "destination": "/mi-comercio/index.html"
    },
    {
      "source": "/merchant",
      "destination": "/merchant.html"
    },
    {
      "source": "/merchant.html",
      "destination": "/merchant.html"
    },
    {
      "source": "/((?!assets/|brand/|mi-comercio|merchant|merchant.html|style.css|app.js|merchant.js|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
